# RIMN Environment Variables — copy to .env and fill in values

# ── Security ──────────────────────────────────────────────────────────────────
SECRET_KEY=rimn-change-this-to-a-random-64-char-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── App ───────────────────────────────────────────────────────────────────────
DEBUG=false
ENVIRONMENT=development

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default, no setup needed)
DATABASE_URL=sqlite+aiosqlite:///./rimn.db

# ── ML ────────────────────────────────────────────────────────────────────────
DEVICE=cpu
CLIP_MODEL=ViT-L-14
CLIP_PRETRAINED=openai
DEBERTA_MODEL=microsoft/deberta-v3-base
WHISPER_MODEL=base
LATENT_DIM=512
MAX_TEXT_LENGTH=512

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
